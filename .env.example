# The production URL this site is deployed at, used to resolve absolute
# metadata URLs (Open Graph images, canonical links, sitemap). Set this in
# your deployment platform's environment variables (e.g. Vercel project
# settings) once the real domain is chosen.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Lab paywall ---
# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SESSION_SECRET=

# Paystack (dashboard.paystack.com > Settings > API Keys & Webhooks). Use
# test-mode keys (sk_test_.../pk_test_...) until the whole flow is verified
# end to end.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Billing is native NGN (no domiciliary/foreign-currency account, so
# Paystack's USD-settlement feature doesn't apply). Create the two
# recurring Plans in NGN under Payments > Plans in the dashboard (one
# monthly, one annual) — Paystack charges whatever amount is configured on
# the Plan itself, so it must match src/lib/pricing.ts's amountNgn values
# exactly (₦18,210 monthly, ₦150,233 annual).
PAYSTACK_PLAN_CODE_MONTHLY=
PAYSTACK_PLAN_CODE_ANNUAL=
# No separate webhook signing secret needed — Paystack signs webhook
# payloads with your PAYSTACK_SECRET_KEY itself (HMAC-SHA512 of the raw
# body, in the x-paystack-signature header). Add
# https://<your-domain>/api/paystack/webhook as the webhook URL under
# Settings > API Keys & Webhooks once you have a live URL to point at.

# Resend (resend.com > API Keys).
RESEND_API_KEY=
# Must be a verified sending domain in Resend, or their test address
# (onboarding@resend.dev) while testing.
RESEND_FROM_EMAIL="Tacitus Dave OS <onboarding@resend.dev>"

# Upstash Redis (upstash.com > your database > REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Control Center (admin) ---
# Separate from SESSION_SECRET on purpose — a leak of one shouldn't
# compromise the other. Generate with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
ADMIN_SESSION_SECRET=

# scrypt hash of your chosen admin password, as "salt:hash" — never the
# plaintext password itself. Generate locally with:
#   node scripts/hash-admin-password.mjs "your-password-here"
ADMIN_PASSWORD_HASH=

# Base32 TOTP secret for the authenticator-app second factor (Google
# Authenticator, Authy, 1Password, etc.). Generate one with otpauth, then
# add it to your authenticator app via the same secret.
ADMIN_TOTP_SECRET=
