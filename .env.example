# The production URL this site is deployed at, used to resolve absolute
# metadata URLs (Open Graph images, canonical links, sitemap). Set this in
# your deployment platform's environment variables (e.g. Vercel project
# settings) once the real domain is chosen.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Lab paywall ---
# Random string used to sign session cookies. Generate one with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
SESSION_SECRET=

# Stripe (stripe.com > Developers > API keys). Use test-mode keys
# (sk_test_.../pk_test_...) until the whole flow is verified end to end.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the "Lab Access" product's two recurring Prices.
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=
# From the webhook endpoint's settings, after adding
# https://<your-domain>/api/stripe/webhook as an endpoint in the Stripe
# dashboard (Developers > Webhooks). Needs a live URL, so this is set up
# after the first deploy.
STRIPE_WEBHOOK_SECRET=

# Resend (resend.com > API Keys).
RESEND_API_KEY=
# Must be a verified sending domain in Resend, or their test address
# (onboarding@resend.dev) while testing.
RESEND_FROM_EMAIL="Tacitus Dave OS <onboarding@resend.dev>"

# Upstash Redis (upstash.com > your database > REST API section).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Control Center (admin) ---
# Separate from SESSION_SECRET on purpose — a leak of one shouldn't
# compromise the other. Generate with:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
ADMIN_SESSION_SECRET=

# scrypt hash of your chosen admin password, as "salt:hash" — never the
# plaintext password itself. Generate locally with:
#   node scripts/hash-admin-password.mjs "your-password-here"
ADMIN_PASSWORD_HASH=

# Base32 TOTP secret for the authenticator-app second factor (Google
# Authenticator, Authy, 1Password, etc.). Generate one with otpauth, then
# add it to your authenticator app via the same secret.
ADMIN_TOTP_SECRET=
